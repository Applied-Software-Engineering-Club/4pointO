NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auto sign-in runs only while `npm run dev` is running.
# Signing out stays signed out until you sign in again or close the browser.
# RLS queries use the anon key plus this session. Do not use the service role key for those reads.
DEVELOPMENT_MODE=true
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=

# Personal Canvas access token for local syllabus-tracker development.
CANVAS_API_TOKEN=
